rules_version = '2';

// ProMultiCam — Firestore database "promulticam"
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function superPath() { return /databases/$(database)/documents/config/super; }
    // Super Admin is fixed to the owner's account
    function isSuper() { return signedIn() && request.auth.uid == 'D3U6Dxs5joZQq5EYRdjZQUmRV773'; }

    // Super Admin record (optional, owner only)
    match /config/super {
      allow read: if signedIn();
      allow create: if isSuper()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'at']);
    }
    // Plans, prices, trial days — public read, Super Admin write
    match /config/{id} {
      allow read: if true;
      allow write: if isSuper();
    }
    // Customer accounts — written by Cloud Functions only
    match /users/{uid} {
      allow read: if isSuper() || (signedIn() && request.auth.uid == uid);
      allow write: if false;
    }
    // Payments — written by Cloud Functions only
    match /payments/{pid} {
      allow read: if isSuper() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }
    // In-app support chat: one thread per customer, readable by that customer and the Super Admin
    match /supportChats/{uid} {
      allow read: if isSuper() || (signedIn() && request.auth.uid == uid);
      allow create, update: if isSuper() || (signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'lastMsg', 'lastAt', 'lastFrom', 'unreadAdmin', 'unreadUser'])
        && request.resource.data.lastMsg is string && request.resource.data.lastMsg.size() <= 300);
      allow delete: if isSuper();
      match /messages/{mid} {
        allow read: if isSuper() || (signedIn() && request.auth.uid == uid);
        allow create: if request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && request.resource.data.keys().hasOnly(['from', 'text', 'at'])
          && ((isSuper() && request.resource.data.from == 'admin')
              || (signedIn() && request.auth.uid == uid && request.resource.data.from == 'user'));
        allow update: if false;
        allow delete: if isSuper();
      }
    }
    // Promo codes — Super Admin only (redemption goes through Cloud Functions)
    match /promos/{code} {
      allow read, write: if isSuper();
      match /uses/{uid} { allow read: if isSuper(); allow write: if false; }
    }
  }
}
