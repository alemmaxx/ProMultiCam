{
  "hosting": {
    "target": "promulticam",
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.@(js|html|json)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  },
  "firestore": [
    { "database": "promulticam", "rules": "firestore.rules", "indexes": "firestore.indexes.json" }
  ],
  "functions": [
    { "source": "functions", "codebase": "promulticam", "ignore": ["node_modules", ".git", "*.local"] }
  ]
}
